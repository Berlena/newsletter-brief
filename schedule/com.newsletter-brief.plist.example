<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.newsletter-brief</string>
  <key>WorkingDirectory</key>
  <string>/REPLACE/WITH/newsletter-brief</string>
  <key>ProgramArguments</key>
  <array>
    <string>/REPLACE/WITH/newsletter-brief/.venv/bin/python</string>
    <string>-m</string>
    <string>newsletter_brief</string>
    <string>run</string>
    <string>--config</string>
    <string>/REPLACE/WITH/newsletter-brief/config.toml</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>8</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>EnvironmentVariables</key>
  <dict>
    <key>LLM_MODEL</key>
    <string>the-model-you-chose</string>
  </dict>
</dict>
</plist>
